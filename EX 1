text = input("Enter the message: ")
k = int(input("Enter the key (1-25): "))

if 1 <= k <= 25:
    result = ""

    for ch in text:
        if ch.isupper():
            result += chr((ord(ch) - ord('A') + k) % 26 + ord('A'))
        elif ch.islower():
            result += chr((ord(ch) - ord('a') + k) % 26 + ord('a'))
        else:
            result += ch

    print("Encrypted message:", result)
else:
    print("Invalid key! Enter a key between 1 and 25.")
