text = input("Enter plaintext: ").upper().replace(" ", "")
key = [9,0,1,7,23,15,21,14,11,11,2,8,9]

if len(text) != len(key):
    print("Key length mismatch")
else:
    cipher = [(ord(c)-65+k)%26
              for c,k in zip(text,key)]
    print("Ciphertext:", ''.join(chr(x+65) for x in cipher))
    print("Key for CASHNOTNEEDED:",
          [(x-y)%26 for x,y in zip(
              cipher, map(lambda c:ord(c)-65,
              "CASHNOTNEEDED".replace(" ","")))])
