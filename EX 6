from math import gcd

c = input("Ciphertext: ").upper()
for a in range(1, 26):
    if gcd(a, 26) == 1:
        inv = pow(a, -1, 26)
        for b in range(26):
            if (4*a+b)%26 == 1 and (19*a+b)%26 == 20:
                print("Key:", a, b)
                print(''.join(
                    chr((inv*(ord(x)-65-b))%26+65)
                    if x.isalpha() else x for x in c))
