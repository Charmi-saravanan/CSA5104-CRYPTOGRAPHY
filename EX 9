def decrypt(text, grid):
    pos = {c:(r,col) for r,row in enumerate(grid)
           for col,c in enumerate(row)}
    out = ""
    for i in range(0, len(text), 2):
        a,b = text[i],text[i+1]
        r1,c1 = pos[a]; r2,c2 = pos[b]
        if r1 == r2:
            out += grid[r1][(c1-1)%5]+grid[r2][(c2-1)%5]
        elif c1 == c2:
            out += grid[(r1-1)%5][c1]+grid[(r2-1)%5][c2]
        else:
            out += grid[r1][c2]+grid[r2][c1]
    return out

grid = [input("Row: ").upper().replace("J","I") for _ in range(5)]
text = input("Ciphertext (letters only): ").upper().replace(" ","")
print(decrypt(text, grid))
